<<< "now:", now >>>;
//en la consola se ve un tiempo, que está basado en muestras, que depende del tiempo en el que se inició el virtual machine


<<< "now (in second):", now / second >>>; 
 
 3::second => now; 
 // whatever now is incremented in 3 seconds. 
 
 <<< "NEW now (in second):", now / second >>>; 
 